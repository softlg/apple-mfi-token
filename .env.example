# apple-mfi-token 必需环境变量。
# 复制为 .env 后填真实值。.env 已在 .gitignore 中，永不入库。
# 本文件只列键名与说明，不含任何真实值。

# ---- 服务 ----
MFI_SERVER_PORT=8090

# ---- MySQL（本机已运行的 MySQL80 服务，或 docker-compose 提供的实例）----
MFI_DB_URL=jdbc:mysql://localhost:3306/apple_mfi_token?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MFI_DB_USERNAME=
MFI_DB_PASSWORD=
# 仅 docker-compose 初始化 MySQL 容器 root 口令用；复用本机 MySQL80 服务时不需要
MFI_DB_ROOT_PASSWORD=

# ---- RabbitMQ（P5 流水线必需）----
MFI_RABBITMQ_HOST=localhost
MFI_RABBITMQ_PORT=5672
MFI_RABBITMQ_USERNAME=
MFI_RABBITMQ_PASSWORD=
MFI_RABBITMQ_VHOST=/

# ---- Redis（sa-token 会话存储，启动即必需；SN 取号复用）----
MFI_REDIS_HOST=localhost
MFI_REDIS_PORT=6379
MFI_REDIS_PASSWORD=
MFI_REDIS_DATABASE=0

# ---- 密钥：必须由密钥管理系统签发，绝不允许提交真实值 ----
# AES-256-GCM 主密钥，Base64 编码的 32 字节。用于加密租户 MFI 证书与私钥。
MFI_CREDENTIAL_MASTER_KEY=
MFI_CREDENTIAL_KEY_ID=v1
